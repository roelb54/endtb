<?xml version="1.0" encoding="UTF-8"?>
<TB.Vx.model.inputfile xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../TB-Vx-schema-Z.xsd">
  <simulation from.year="1900" thru.year="2021">
    <options>
      <numerical.integration method="ode23" rtol="1e-3" atol="1e-3" min.value.for.state.var="-0.03"/>
    </options>
    <!--<demography country.code="ignored">-->
    <demography country.code="ignored" rescale.population="1950">
      <!-- ignored really means from command line-->
      <from.data>
        <population file="data/demographics.csv"/>
        <birthrate from.population.data="true"/>
        <!-- if false: fraction="0.024" or number="5000" -->
        <mortality file="data/deathrates.csv"/>
        <!-- country code will be prepended to file name e.g. ZAF_deathrates.csv -->
      </from.data>
    </demography>
    <contact.matrix file="data/all_contacts_2020.txt"/>
    <!-- country code will be prepended to file name e.g. ZAF_all_contacts_2020.txt -->
  </simulation>
  <output>
    <!--<final.population.as.fraction file="./data/IN-final-population-2050.txt"/>-->
    <detailed.output years="c(2000,2010,2019,2020)+0.5" age.group.lower.limits="c(0,15)" econ.output="false" suppress.zeros.in.stocks="false" suppress.zeros.in.flows="false" combine.stocks.and.flows="true">
      <flows dim="TB" incidence="true" transmission="true" progression="true" treatment="true"/>
      <flows dim="HIV" incidence="true" transmission="false" progression="true" treatment="true"/>
      <flows dim="VXa" incidence="true" transmission="false" progression="false" treatment="false"/>
      <flows dim="RISK"/>
    </detailed.output>
  </output>
  <ages lower.limits="5*(0:15)"/>
  <!--ages lower.limits="c(0:80,90)"/-->
  <VXa>
    <VXa.stages>
      <stage name="never" fraction.at.birth="1"/>
    </VXa.stages>
  </VXa>
  <SES>
    <SES.stages>
      <stage name="ses1"/>
      <!--stage name="high" fraction.at.birth="0.6"/-->
    </SES.stages>
  </SES>
  <RISK>
    <RISK.stages>
      <stage name="risk1"/>
    </RISK.stages>
  </RISK>
  <HIV>
    <HIV.stages>
      <stage name="HIV-" fraction.at.birth="1"/>
    </HIV.stages>
  </HIV>
  <TB>
    <TB.stages>
      <stage name="Un" fraction.at.birth="1"/>
      <stage name="Uc"/>
      <stage name="Lf"/>
      <stage name="Ls"/>
      <stage name="Ds"/>
      <stage name="Dc"/>
      <stage name="T"/>
      <stage name="R"/>
      <stage name="TPT"/>
      <stage name="TBdead"/>
      <stage name="Rdead"/>
    </TB.stages>
    <seeded.infections name="multiplier" value="1">
      <seeded.infection fraction="0.246" age.from="0" age.thru="99" stage="Uc"/>
      <seeded.infection fraction="0.0188" age.from="0" age.thru="99" stage="Lf"/>
      <seeded.infection fraction="0.198" age.from="0" age.thru="99" stage="Ls"/>
      <seeded.infection fraction="0.00317" age.from="0" age.thru="99" stage="Ds"/>
      <seeded.infection fraction="0.00265" age.from="0" age.thru="99" stage="Dc"/>
      <seeded.infection fraction="0.0484" age.from="0" age.thru="99" stage="R"/>
    </seeded.infections>
    <TB.progression>
      <age.groups>
        <age.group name="A0"/>
        <age.group name="A15"/>
      </age.groups>
      <TB.parameter name="pE" value="0"/>
      <!--TB.parameter SES.stage="high" name="pE" value="0.3567966523385633"/-->
      <TB.parameter name="sage" age.group="A0" value="1"/>
      <TB.parameter name="sage" age.group="A15" value="0.655943563330546"/>
      <TB.parameter name="j1" age.group="A0" value="0.91985565683198"/>
      <TB.parameter name="j1" age.group="A15" value="1"/>
      <TB.parameter name="j2" age.group="A0" value="1"/>
      <TB.parameter name="j2" age.group="A15" value="1"/>
      <TB.parameter name="j3" age.group="A0" value="1"/>
      <TB.parameter name="j3" age.group="A15" value="1"/>
      <TB.parameter name="j4" age.group="A0" value="0.983526014701738"/>
      <TB.parameter name="j4" age.group="A15" value="1"/>
      <TB.parameter name="phiF" value="1.4e-6"/>
      <TB.parameter name="omega" value="0.5"/>
      <TB.parameter name="tau" value="0.5"/>
      <TB.parameter name="phiS" value="0.0467"/>
      <TB.parameter name="theta" value="0.111"/>
      <TB.parameter name="thetamin" value="0.0696"/>
     <TB.parameter name="sigma" value="0.00113"/>
     
      <TB.parameter name="sigmamin" value="0.000135"/>
      <TB.parameter name="rho" value="0.000375578252997321"/> <!-- 0.000173102625665814-->
      <TB.parameter name="rhomin" value="0.0001"/>
      <TB.parameter name="zeta" value="0.43"/>
      <TB.parameter name="chi" value="0.25"/>
      <TB.parameter name="eta" value="0.40"/>
      <TB.parameter name="kappa" value="0.228"/>
      <!-- COUNTRY SPECIFIC VALUE-->
      <TB.parameter name="sfr" value="0.947806648"/>
      <!-- COUNTRY SPECIFIC VALUE-->
      <TB.parameter name="muK" value="0.003"/>
      <TB.parameter name="muDc" value="0.178"/>
 
      <TB.parameter name="midx" value="2003.4166918436"/>
      <TB.parameter name="sh" value="0.2"/>
      <TB.parameter name="hhsize" value="3.5"/>
      <transition.matrix>
        <transition from="Lf" to="Ls" rate="omega"/>
        <transition from="Lf" to="Uc" rate="phiF"/>
        <transition from="Ls" to="Uc" rate="phiS"/>
       <transition from="Ds" to="Dc" rate="zeta"/>
        <transition from="Ds" to="R" rate="chi"/>
        <transition from="Dc" to="R" rate="chi"/>
        <transition from="Dc" to="TBdead" rate="sage*muDc"/>
        <transition from="R" to="Rdead" rate="sage*muK*0.22"/>
      </transition.matrix>
      <!-- INDVIDUAL INC FLOW MATRIX : to get required flows-->
      <treatment.matrix name="RDs">
        <transition from="R" to="Ds" rate="(1-pE)*max(rhomin,j3*rho)"/>
      </treatment.matrix>
      <treatment.matrix name="LfLsDs">
        <transition from="Lf" to="Ds" rate="(1-pE)*max(thetamin,j1*theta)"/>
        <transition from="Ls" to="Ds" rate="(1-pE)*max(sigmamin,j2*sigma)"/>
      </treatment.matrix>
      <treatment.matrix name="init">
        <transition from="Dc" to="T" rate="eta"/>
        <multiplier name="etamul" times="1960:2030" values="1/(1+exp(-sh*(x-midx)))"/>
      </treatment.matrix>
      <treatment.matrix name="TPT" trigger="TB:Dc">
        <transition from="Ls" to="TPT" rate="(hhsize-1)*eta"/>
        <transition from="Lf" to="TPT" rate="(hhsize-1)*eta"/>
        <multiplier name="etamul" times="1960:2030" values="1/(1+exp(-sh*(x-midx)))"/>
      </treatment.matrix>
      <treatment.matrix name="nodead">
        <transition from="T" to="Dc" rate=   "(1-sfr)*(1-kappa*sage)/tau"/>
        <transition from="T" to="R"  rate="(1-(1-sfr)*(1-sfr*kappa*sage))/tau"/>
      </treatment.matrix>
      <treatment.matrix name="died">
        <transition from="T" to="TBdead"    rate="kappa*sage/tau"/>
      </treatment.matrix>
    </TB.progression>
    <TB.infectivity>
      <age.groups>
        <age.group name="A0"/>
        <age.group name="A15"/>
      </age.groups>
      <TB.parameter name="infs" value="0.8"/>
      <TB.parameter name="infc" value="1"/>
      <TB.parameter name="ep" value="0.06732768"/>
      <!-- COUNTRY SPECIFIC VALUE-->
      <infectivity.matrix Mtb-strain="DS">
        <infectivity stage="Ds" value="(1-ep)*infs"/>
        <infectivity stage="Dc" value="(1-ep)*infc"/>
      </infectivity.matrix>
    </TB.infectivity>
    <TB.transmission>
      <age.groups>
        <age.group name="A0"/>
        <age.group name="A15"/>
      </age.groups>
      <TB.parameter name="pE" value="0"/>
      <TB.parameter name="pT" value="0.000849700950142821"/> <!-- 1e-16-->
      <TB.parameter name="pC" value="0.5"/>
      <TB.parameter name="pR" value="0.6"/>
      <TB.parameter name="omega" value="0.5"/>
      <TB.parameter name="theta" value="0.111"/>
      <TB.parameter name="thetamin" value="0.0696"/>
      <TB.parameter name="j1" age.group="A0" value="0.91985565683198"/>
      <TB.parameter name="j1" age.group="A15" value="1"/>
      <transmission.matrix Mtb-strain="DS">
        <transition from="Un" to="Lf" rate="(1-pE)*pT"/>
        <transition from="Uc" to="Lf" rate="(1-pE)*pT*(1-pR*pC)"/>
        <transition from="Ls" to="Lf" rate="(1-pE)*pT*(1-pR)"/>
        <transition from="R" to="Ds" rate="(1-pE)*pT*(1-pR)*((1-pE)*max(thetamin,j1*theta))/(max(0.01,(1-pE))*max(thetamin,j1*theta)+omega)"/>
      <multiplier name="beta" times="1800,2020" values="1,1"/>
      </transmission.matrix>
    </TB.transmission>
  </TB>
</TB.Vx.model.inputfile>
