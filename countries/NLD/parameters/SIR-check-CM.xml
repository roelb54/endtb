<?xml version="1.0" encoding="UTF-8"?>
<TB.Vx.model.inputfile xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../TB-Vx-schema-V2.xsd">
  <simulation from.year="2019" thru.year="2023" dt="0.02"><!-- dt = 0.02 ; so about 1 week -->
    <options>
      <numerical.integration method="ode23" min.value.for.state.var="-3e-3"/>
    </options>
    <demography country.code="ignored" rescale.population="2050">
      <from.data>
        <population file="data/demographics.csv"/>
        <birthrate from.population.data="true"/>
        <mortality file="data/deathrates.csv"/>
      </from.data>
    </demography>
    <contact.matrix file="data/all_contacts_2021.txt"/>
  </simulation>
  <output>
   <detailed.output years="2019+(0:200)*0.02" age.group.lower.limits="c(0,15)">
      <flows dim="TB" transmission="true" progression="true"/>
      <flows dim="HIV"/>
      <flows dim="VXa"/>
      <flows dim="RISK"/>
    </detailed.output>
  </output>
  <ages lower.limits="5*(0:15)"/>
  <VXa> <VXa.stages> <stage name="NA"/></VXa.stages> </VXa>
  <SES> <SES.stages> <stage name="NA"/></SES.stages> </SES>
  <RISK><RISK.stages><stage name="NA"/></RISK.stages></RISK>
  <HIV> <HIV.stages> <stage name="NA"/></HIV.stages> </HIV>
  <TB>
    <TB.stages>
      <stage name="S" />
      <stage name="I" />
      <stage name="R" />
    </TB.stages>
    <seeded.infections name="multiplier" value="1">
      <seeded.infection fraction="0" age.from="0" age.thru="99" stage="I"/>
      <seeded.infection fraction="0" age.from="0" age.thru="99" stage="R"/>
    </seeded.infections>
 
    <TB.incidence>
      <incidence.data file="data/SARSCoV2-incidence-I.txt" times="1980,2051" values="1,1" proportions="false" denominator="susc"/>
    </TB.incidence>
    <TB.progression>
      <TB.parameter name="dinf" value="7" />
      <transition.matrix>
        <transition from="I" to="R" rate="1/(dinf/365.2425)" />
      </transition.matrix>
    </TB.progression>
   <TB.infectivity>
      <TB.parameter name="infc" value="1" /> 
      <infectivity.matrix>
        <infectivity stage="I" value="infc" />
      </infectivity.matrix>
    </TB.infectivity>
    <TB.transmission>
    <TB.parameter name="bc" value="0.4" />
      <transition.matrix>
        <transition from="S" to="I" rate="bc" />
      </transition.matrix>
    </TB.transmission>
  </TB>
</TB.Vx.model.inputfile>