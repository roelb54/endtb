<?xml version="1.0" encoding="UTF-8"?>
<TB.Vx.model.inputfile xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../TB-Vx-EndTB-schema-E.xsd">
  <simulation from.year="1900" thru.year="2051">
    <options>
      <numerical.integration method="ode23" min.value.for.state.var="-1e-2"/>
    </options>
    <demography country.code="ignored" rescale.population="1950">
      <from.data>
        <population file="data/demographics.csv"/>
        <birthrate from.population.data="true"/>
        <mortality file="data/deathrates.csv"/>
      </from.data>
    </demography>
    <contact.matrix file="data/all_contacts_2021.txt" Mtb-strain="drugsens"/>
  </simulation>
  <output>
    <!--<final.population.as.fraction file="./data/IN-final-population-2050.txt"/>-->
    <detailed.output years="c(1980:2025,2030,2035,2040,2045,2050)+0.5" age.group.lower.limits="0,15,55" econ.output="false" suppress.zeros.in.stocks="false" suppress.zeros.in.flows="false" combine.stocks.and.flows="false">
      <flows dim="TB" incidence="true" transmission="true" progression="true" treatment="true"/>
      <flows dim="HIV" incidence="true" transmission="false" progression="true" treatment="true"/>
      <flows dim="RISK"/>
      <flows dim="SES"/>
      <flows dim="VXa"/>
    </detailed.output>
  </output>
  <ages lower.limits="5*(0:15)"/>
  <VXa>
    <VXa.stages>
      <stage name="none"/>
      <stage name="TPT" />
      <stage name="treatDsDc" />
      <stage name="TPTcount" />
    </VXa.stages>
        <VXa.progression>
        <age.groups>
        <age.group name="A0"/> 
        <age.group name="A15"/> 
      </age.groups>
      <!--NEVER TREATED-->
      <VXa.parameter TB.stage="Un" name="screenpos" value="0" /> 
      <VXa.parameter TB.stage="Uc" name="screenpos" value="0" />
      <VXa.parameter TB.stage="R" name="screenpos" value="0" />
      <VXa.parameter TB.stage="Lf" name="screenpos" value="0" />
      <VXa.parameter TB.stage="Ls" name="screenpos" value="0" />
      <VXa.parameter TB.stage="Ds" name="screenpos" value="1" />
      <VXa.parameter TB.stage="Dc" name="screenpos" value="1" />
      <VXa.parameter TB.stage="T" name="screenpos" value="0" />
      <VXa.parameter TB.stage="TBdead" name="screenpos" value="0" />
      <VXa.parameter TB.stage="Rdead" name="screenpos" value="0" />      
      <VXa.parameter TB.stage="Un" name="toTPT" value="0" /> 
      <VXa.parameter TB.stage="Uc" name="toTPT" value="0" />
      <VXa.parameter TB.stage="R" name="toTPT" value="0" />
      <VXa.parameter TB.stage="Lf" name="toTPT" value="1" />
      <VXa.parameter TB.stage="Ls" name="toTPT" value="1" />
      <VXa.parameter TB.stage="Ds" name="toTPT" value="0" />
      <VXa.parameter TB.stage="Dc" name="toTPT" value="0" />
      <VXa.parameter TB.stage="T" name="toTPT" value="0" />
      <VXa.parameter TB.stage="TBdead" name="toTPT" value="0" />
      <VXa.parameter TB.stage="Rdead" name="toTPT" value="0" />
      <VXa.parameter name="hhsize_1" value="3.4"/>
      <VXa.parameter age.group="A0" name="ageTPT" value="1"/>
      <VXa.parameter age.group="A15" name="ageTPT" value="1"/>
      <VXa.parameter name="TPTdur" value="0.5"/><!-- e.g. 0.5 year duration of TPT -->
<VXa.parameter name="factorLfLsinHHDc" value="4"/>
<VXa.parameter name="covandcomp" value="0.7"/>
<VXa.parameter name="tau" value="0.5"/><!-- from TB treatment duration -->


      <transition.matrix>
        <transition from="TPT" to="none" rate="1/TPTdur"/>
      </transition.matrix>
      <treatment.matrix name="initTPT"> 
        <transition from="none" to="treatDsDc" rate="screenpos"/>
        <transition from="none" to="TPT" rate="toTPT*ageTPT"/>
        <transition from="none" to="TPTcount" rate="toTPT*ageTPT"/>
        <multiplier name="tptmul" times="2000,2025,2030" values="0,0,0"/>
      </treatment.matrix> 
      <!--treatment.matrix name="hhTPT" trigger="TB:T"> 
        <transition from="none" to="TPT" rate="toTPT*ageTPT"/>
        <transition from="none" to="TPTcount" rate="toTPT*ageTPT"/>
        <multiplier name="tptmul" times="2000,2025,2030" values="0,0,4*factorLfLsinHHDc*covandcomp*hhsize_1"/>
      </treatment.matrix--> 
      <!--treatment.matrix name="allTPT"> 
        <transition from="none" to="TPT" rate="etatpt*toTPT*ageTPT"/>
        <transition from="none" to="TPTcount" rate="etatpt*toTPT*ageTPT"/>
        <multiplier name="etatptmul" times="1980:2030" values="0/(1+exp(-shtpt*(x-midxtpt)))"/>
      </treatment.matrix--> 
    </VXa.progression>
  </VXa>
  <SES>
    <SES.stages>
      <stage name="low" fraction.at.birth="0.4"/>
      <stage name="high" fraction.at.birth="0.6"/>
    </SES.stages>
  </SES>
  <RISK>
    <RISK.stages>
      <stage name="risk1"/>
      <!--<stage name="risk0" /> -->
    </RISK.stages>
    <!--
    <RISK.progression>
      <age.groups>
        <age.group name="A0"/>
      </age.groups>
      <RISK.parameter name="alpha" value="0.05" />
      <RISK.parameter name="beta" value="0.2" />
      <transition.matrix>
        <transition from="risk0" to="risk1" rate="alpha" />
        <transition from="risk1" to="risk0" rate="beta" />
      </transition.matrix>
    </RISK.progression>
    -->
  </RISK>
  <HIV>
    <HIV.stages>
      <!--Included the HIV stage names and parameters 26/10/2020CM -->
      <stage name="HIV-" fraction.at.birth="1"/>
      <!-- to test HIV, set fraction.at.birth e.g. to 0.95 for HIV- and to 0.05 for HIV1 -->
      <stage name="HIV1"/>
      <stage name="ART1"/>
      <stage name="HIVdead"/>
    </HIV.stages>
    <HIV.incidence>
      <incidence.data file="data/HIV-incidence.txt" times="2000:2019" values="lambdaH*(1-arteff*artcov/(1+exp(-0.5*(x-2009.5))))" proportions="false" denominator="susc"/>
      <!--<incidence.data file="data/HIV-incidence.txt" times="1900,2051" values="lambdaH,lambdaH" proportions="false" denominator="susc"/>-->
      <!--<incidence.data file="data/ART-incidence.txt" times="1900,2051" values="alphaH,alphaH" proportions="false" denominator="susc"/> -->
      <incidence.data file="data/ART-incidence.txt" times="2000:2019" values="alphaH/(1+exp(-0.5*(x-2009.5)))" proportions="false" denominator="susc"/>
    </HIV.incidence>
    <HIV.progression>
      <HIV.parameter name="artcov" value="0.82"/>
      <HIV.parameter name="arteff" value="0.75"/>
      <!--HIV.parameter name="incimul" value="0.3"/-->
      <HIV.parameter name="lambdaH" value="39.6970811755018"/>
      <!-- lambdaH is a parameter to be fitted to 2019 HIV prevalence -->
      <HIV.parameter name="alphaH" value="2028.18895431133"/>
      <!-- alphaH is a parameter to be fitted to 2019 ART coverage -->
      <HIV.parameter name="betaH" value="0.0590152590950911"/>
      <HIV.parameter name="muH" value="0.0914076537279901"/>
      <!--0.17-->
      <!--HIV.parameter name="deltaH" value="0.0005"/-->
      <transition.matrix>
        <transition from="ART1" to="HIV1" rate="betaH"/>
      </transition.matrix>
      <!-- INDVIDUAL INC FLOW MATRIX : to get required flows into HIVdead-->
      <!-- modified by chris 02.02.2021-->
      <treatment.matrix name="HivArtHdead">
        <transition from="HIV1" to="HIVdead" rate="muH"/>
        <transition from="ART1" to="HIVdead" rate="0.26*muH"/>
      </treatment.matrix>
    </HIV.progression>
  </HIV>
  <TB>
    <TB.stages>
      <stage name="Un" fraction.at.birth="1"/>
      <stage name="Uc"/>
      <stage name="Lf"/>
      <stage name="Ls"/>
      <stage name="Ds"/>
      <stage name="Dc"/>
      <stage name="T"/>
      <stage name="R"/>
      <stage name="TBdead"/>
      <stage name="Rdead"/>
    </TB.stages>
    <seeded.infections name="multiplier" value="0.135131542888932">
      <seeded.infection fraction="0.246" age.from="0" age.thru="99" stage="Uc"/>
      <seeded.infection fraction="0.0188" age.from="0" age.thru="99" stage="Lf"/>
      <seeded.infection fraction="0.198" age.from="0" age.thru="99" stage="Ls"/>
      <seeded.infection fraction="0.00317" age.from="0" age.thru="99" stage="Ds"/>
      <seeded.infection fraction="0.00265" age.from="0" age.thru="99" stage="Dc"/>
      <seeded.infection fraction="0.0484" age.from="0" age.thru="99" stage="R"/>
    </seeded.infections>
    <TB.progression>
      <age.groups>
        <age.group name="A0"/>
        <age.group name="A15"/>
      </age.groups>
      <TB.parameter SES.stage="low" name="pE" value="0"/>
      <TB.parameter SES.stage="high" name="pE" value="0.371680737732466"/>
      <TB.parameter name="sage" age.group="A0" value="1"/>
      <TB.parameter name="sage" age.group="A15" value="0.9544770811723"/>
      <TB.parameter name="j1" age.group="A0" value="0.376149212940958"/>
      <TB.parameter name="j1" age.group="A15" value="1"/>
      <TB.parameter name="j2" age.group="A0" value="0.0619648687878969"/>
      <TB.parameter name="j2" age.group="A15" value="1"/>
      <TB.parameter name="j3" age.group="A0" value="0.597278738041473"/>
      <TB.parameter name="j3" age.group="A15" value="1"/>
      <TB.parameter name="j4" age.group="A0" value="0.905457783016686"/>
      <TB.parameter name="j4" age.group="A15" value="1"/>
      <TB.parameter name="phiF" value="1.4e-06"/>
      <TB.parameter name="omega" value="0.5"/>
      <TB.parameter name="tau" value="0.5"/>
      <TB.parameter name="phiS" value="0.0339036319808181"/>
      <TB.parameter name="theta" value="0.100365426370728"/>
      <TB.parameter name="thetamul" value="13.7964698183908"/>
      <TB.parameter HIV.stage="HIV-" name="th1" value="0"/>
      <TB.parameter HIV.stage="HIV1" name="th1" value="1"/>
      <TB.parameter HIV.stage="ART1" name="th1" value="0.35"/>
      <TB.parameter HIV.stage="HIVdead" name="th1" value="0"/>
      <TB.parameter name="sigma" value="0.000851265949373592"/>
      <TB.parameter name="rho" value="0.0276046053396532"/>
      <TB.parameter name="zeta" value="1.02107073652574"/>
      <TB.parameter name="chi" value="0.186144639905393"/>
      <TB.parameter name="eta" value="0.720763638065559"/>
      <TB.parameter name="kappa" value="0.136530295003161"/>
      <!-- COUNTRY SPECIFIC VALUE-->
      <TB.parameter name="sfr" value="0.98"/>
      <!-- COUNTRY SPECIFIC VALUE-->
      <TB.parameter name="muK" value="0.0103270463845909"/>
      <TB.parameter name="muDc" value="0.171762940081403"/>
      <TB.parameter HIV.stage="HIV-" name="HIVmult" value="1.0"/>
      <TB.parameter HIV.stage="HIV1" name="HIVmult" value="1.50"/>
      <TB.parameter HIV.stage="ART1" name="HIVmult" value="1.15"/>
      <TB.parameter HIV.stage="HIVdead" name="HIVmult" value="1.0"/>
      <TB.parameter name="midx" value="2007.01390122451"/>
      <TB.parameter name="sh" value="0.2"/>
      <TB.parameter VXa.stage="none"    name="ontpt"       value="0"/>
      <TB.parameter VXa.stage="TPT"    name="ontpt"       value="1"/>
      <TB.parameter VXa.stage="TPTcount"    name="ontpt"       value="0"/>
      <TB.parameter VXa.stage="treatDsDc"    name="ontpt"       value="0"/>
      <TB.parameter VXa.stage="none"    name="curedbytpt"       value="0"/>
      <TB.parameter VXa.stage="TPT"    name="curedbytpt"       value="1"/>
      <TB.parameter VXa.stage="TPTcount"    name="curedbytpt"       value="0"/>
      <TB.parameter VXa.stage="treatDsDc"    name="curedbytpt"       value="0"/>
      <TB.parameter VXa.stage="none"    name="screenpos"       value="0"/>
      <TB.parameter VXa.stage="TPT"    name="screenpos"       value="0"/>
      <TB.parameter VXa.stage="TPTcount"    name="screenpos"       value="0"/>
      <TB.parameter VXa.stage="treatDsDc"    name="screenpos"       value="1"/>
      <TB.parameter name="TPTdur" value="0.5"/><!-- e.g. 0.5 year duration of TPT -->
      <transition.matrix>
        <transition from="Lf" to="Ls" rate="omega"/>
        <transition from="Lf" to="Uc" rate="phiF"/>
        <transition from="Ls" to="Uc" rate="phiS"/>
        <transition from="Ds" to="Dc" rate="zeta"/>
        <transition from="Ds" to="R" rate="chi"/>
        <transition from="Dc" to="R" rate="chi"/>
        <transition from="Dc" to="TBdead" rate="muDc*sage*HIVmult"/>
        <transition from="R" to="Rdead" rate="muK*sage*HIVmult*0.22"/>
        <!-- also multiply this rate with HIVmult ??? -->
      </transition.matrix>
      <treatment.matrix name="curedbyTPT">
        <transition from="Lf" to="Un" rate="curedbytpt/TPTdur"/>
        <transition from="Ls" to="Un" rate="curedbytpt/TPTdur"/>
        <transition from="Ds" to="T" rate="screenpos"/>
        <transition from="Dc" to="T" rate="screenpos"/>
      </treatment.matrix>
      <!-- INDVIDUAL INC FLOW MATRIX : to get required flows-->
      <!-- modified by chris 09.12.2020-->
      <treatment.matrix name="LfLsRDs">
        <transition from="Lf" to="Ds" rate="(1-pE)*max(0.0696,theta*(1+th1*(thetamul-1))*j1)"/>
        <transition from="Ls" to="Ds" rate="(1-pE)*max(0.000135,sigma*(1+th1*(thetamul-1))*j2)"/>
        <transition from="R" to="Ds" rate="(1-pE)*max(0.01,rho*(1+th1*(thetamul-1))*j3)"/>
      </treatment.matrix>
      <!-- TREATMENT INITIATION MATRIX -->
      <treatment.matrix name="init">
        <transition from="Dc" to="T" rate="eta*j4/(1-pE)"/>
        <!--multiplier name="etamul" times="1900,1901" values="1,1"/-->
        <multiplier name="etamul" times="1959:2019" values="1/(1+exp(-sh*(x-midx)))"/>
      </treatment.matrix>
      <!-- TREATMENT SUCCESS/FAILURE/MORTALITY - MAY VARY BY COUNTRY-->
      <treatment.matrix name="nodead">
        <transition from="T" to="Dc" rate="(1-sfr)/tau"/>
        <transition from="T" to="R" rate="sfr/tau"/>
      </treatment.matrix>
      <treatment.matrix name="died">
        <transition from="T" to="Dc" rate="-(1-sfr)*kappa*sage*HIVmult/tau"/>
        <transition from="T" to="R" rate="-sfr*kappa*sage*HIVmult/tau"/>
        <transition from="T" to="TBdead" rate="kappa*sage*HIVmult/tau"/>
        <!-- also multiply this rate with HIVmult ??? in that case: any effect on other compensating rates ?? -->
      </treatment.matrix>
    </TB.progression>
    <TB.infectivity>
      <age.groups>
        <age.group name="A0"/>
        <age.group name="A15"/>
      </age.groups>
      <TB.parameter name="infs" value="0.8"/>
      <TB.parameter name="infc" value="1"/>
      <TB.parameter name="ep" value="0.172605759"/>
      <!-- COUNTRY SPECIFIC VALUE-->
      <infectivity.matrix Mtb-strain="drugsens">
        <infectivity stage="Ds" value="(1-ep)*infs"/>
        <infectivity stage="Dc" value="(1-ep)*infc"/>
      </infectivity.matrix>
    </TB.infectivity>
    <TB.transmission>
      <age.groups>
        <age.group name="A0"/>
        <age.group name="A15"/>
      </age.groups>
      <TB.parameter SES.stage="low" name="pE" value="0"/>
      <TB.parameter SES.stage="high" name="pE" value="0.371680737732466"/>
      <TB.parameter name="pT" value="0.00064547973394737"/>
      <TB.parameter name="pC" value="0.5"/>
      <TB.parameter name="pR" value="0.805545301360016"/>
      <TB.parameter name="omega" value="0.5"/>
      <TB.parameter name="theta" value="0.100365426370728"/>
      <TB.parameter name="thetamul" value="13.7964698183908"/>
      <TB.parameter HIV.stage="HIV-" name="th1" value="0"/>
      <TB.parameter HIV.stage="HIV1" name="th1" value="1"/>
      <TB.parameter HIV.stage="ART1" name="th1" value="0.35"/>
      <TB.parameter HIV.stage="HIVdead" name="th1" value="0"/>
      <TB.parameter name="j1" age.group="A0" value="0.376149212940958"/>
      <TB.parameter name="j1" age.group="A15" value="1"/>
      <transmission.matrix Mtb-strain="drugsens">
        <transition from="Un" to="Lf" rate="(1-pE)*pT"/>
        <transition from="Uc" to="Lf" rate="(1-pE)*pT*(1-pR*pC)"/>
        <transition from="Ls" to="Lf" rate="(1-pE)*pT*(1-pR)"/>
        <!--transition from="R" to="Ds" rate="(1-pE)*pT*(max(0.0696,j1*theta*th1)/omega)*(1-pR)"/>-->
        <transition from="R" to="Ds" rate="(1-pE)*pT*(max(0.0696,j1*theta*(1+th1*(thetamul-1)))/(max(0.0696,j1*theta*(1+th1*(thetamul-1)))+omega))*(1-pR)"/>
        <multiplier name="beta" times="1800,2020" values="1,1"/>
      </transmission.matrix>
    </TB.transmission>
  </TB>
</TB.Vx.model.inputfile>
